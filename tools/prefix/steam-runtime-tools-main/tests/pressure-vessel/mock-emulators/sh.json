{
  "emulator_v0": {
    "argv": "./wrapper.sh --",
    "container_argv": "./wrapper.sh --container --",
    "main_argv": "./wrapper.sh --main --",
    "server_argv": "./server.sh --argument",
    "environment": {
      "PV_TEST_SET_WHEN_EMULATING": "set",
      "PV_TEST_UNSET_WHEN_EMULATING": null
    },
    "container_environment": {
      "PV_TEST_SET_IN_CONTAINER": "set",
      "PV_TEST_UNSET_IN_CONTAINER": null
    },
    "emulated_architectures": ["x86_64-linux-gnu"],
    "required_architectures": ["i386-linux-gnu"],
    "required_libraries": ["libc.so.6", "libm.so.6"]
  }
}
