{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "../src/renderer/src/main.tsx",
    "../src/renderer/src/env.d.ts",
    "../app/Catalogo/GameMod/ui/**/*",
    "../app/Catalogo/GameMod/ui/**/*.tsx",
    "../app/ProtonTools/renderer/**/*",
    "../app/ProtonTools/renderer/**/*.tsx",
    "../src/big-picture/src/**/*",
    "../src/big-picture/src/**/*.tsx",
    "../src/preload/*.d.ts",
    "../src/locales/index.ts",
    "../src/shared/**/*",
  "../src/stories/**/*",
  "../src/types/**/*",
  "../app/Games/**/*",
    "../app/Home/**/*",
    "../app/Catalogue/**/*",
    "../app/Downloads/**/*",
    "../app/Settings/**/*",
    "../app/Profile/**/*",
    "../app/EmulatorDetail/**/*",
    "../app/Emulators/**/*",
    "../app/ExecutableSelect/**/*",
    "../app/FolderSelect/**/*",
    "../app/Library/**/*",
    "../app/Scripts/**/*",
    "../app/Notifications/**/*",
    "../app/SharedModals/**/*",
    "../app/ThemeEditor/**/*",
    "../app/_shared/components/**/*",
    "../app/_shared/hooks/**/*",
    "../app/_shared/context/**/*",
    "../app/_shared/services/**/*",
    "../app/_shared/utils/**/*",
    "../app/_shared/features/**/*",
    "../app/_shared/store.ts",
    "../app/_shared/logger/*",
    "../app/_shared/helpers.ts",
    "../app/_shared/constants.ts",
    "../app/_shared/cookies.ts",
    "../app/_shared/types/**/*",
    "../app/_styles/scss/**/*",
    "../app/_styles/theme/**/*",
    "../app/_assets/**/*",
  "../.storybook/**/*"
  ],
  "exclude": [
    // Cópia morta do antigo src/ (nada importa estes arquivos)
    "../app/Games/src/**",
    // Código main-process (checado pelo tsconfig.node.json)
    "../app/Games/events/**",
    "../app/Games/services/delete-game.ts",
    "../app/Games/services/game-executables.ts",
    "../app/Games/services/game-log-manager.ts",
    "../app/Games/services/process-watcher.ts",
    "../app/Games/services/game-launcher/install/**",
    "../app/Games/services/game-launcher/launch/**",
    "../app/Games/services/game-launcher/play/**",
    "../app/Games/services/game_launcher/**",
    // Main-process: collector de specs + comparador de compatibilidade
    "../app/Games/services/system-specs/**",
    "../app/Games/AddGame/add-custom-game-to-library.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": "..",
    "noUnusedLocals": false,
    "paths": {
      "@types": ["src/types/index.ts"],
      "@mods/*": ["app/Catalogo/GameMod/*"],
      "@locales": ["src/locales/index.ts"],
      "@locales/*": ["src/locales/*"],
      "@shared": ["src/shared/index.ts"],
      "@emulators/*": ["tools/emulators/*"],
      "@provision/*": ["app/_main/installer-api/*"],
      "@proton/*": ["app/ProtonTools/*"],
"@game-launcher/*": ["app/Games/services/game-launcher/*"],
      "@games-ui": ["app/Games/index.tsx"],
      "@games-ui/*": ["app/Games/*"],
      "@container/*": ["app/_main/container/*"],
      "@home/*": ["app/Home/*"],
      "@catalogue": ["app/Catalogue/index.tsx"],
      "@catalogue/*": ["app/Catalogue/*"],
      "@downloads": ["app/Downloads/index.tsx"],
      "@downloads/*": ["app/Downloads/*"],
      "@settings/*": ["app/Settings/*"],
      "@profile/*": ["app/Profile/*"],
      "@emulator-detail/*": ["app/EmulatorDetail/*"],
      "@emulators/*": ["app/Emulators/*"],
      "@emulators/types": ["app/_main/emulators/types.ts"],
      "@executable-select/*": ["app/ExecutableSelect/*"],
      "@folder-select/*": ["app/FolderSelect/*"],
      "@library/*": ["app/Library/*"],
      "@scripts/*": ["app/Scripts/*"],
      "@notifications/*": ["app/Notifications/*"],
      "@shared-modals/*": ["app/SharedModals/*"],
      "@theme-editor/*": ["app/ThemeEditor/*"],
      "@components": ["app/_shared/components/index.ts"],
      "@components/*": ["app/_shared/components/*"],
      "@hooks": ["app/_shared/hooks/index.ts"],
      "@hooks/*": ["app/_shared/hooks/*"],
      "@context": ["app/_shared/context/index.ts"],
      "@context/*": ["app/_shared/context/*"],
      "@features": ["app/_shared/features/index.ts"],
      "@features/*": ["app/_shared/features/*"],
"@shared-services/*": ["app/_shared/services/*"],
      "@shared-utils/*": ["app/_shared/utils/*"],
      "@shared-store": ["app/_shared/store.ts"],
      "@shared-logger": ["app/_shared/logger/index.ts"],
      "@shared-logger/*": ["app/_shared/logger/*"],
      "@shared-helpers": ["app/_shared/helpers.ts"],
      "@shared-helpers/*": ["app/_shared/*"],
      "@shared-constants": ["app/_shared/constants.ts"],
      "@shared-constants/*": ["app/_shared/*"],
      "@shared-cookies": ["app/_shared/cookies.ts"],
      "@shared-cookies/*": ["app/_shared/*"],
      "@assets/*": ["app/_assets/*"],
      "@theme/*": ["app/_styles/theme/*"]
    }
  }
}
