{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "../src/renderer/src/env.d.ts",
    "../src/renderer/src/**/*",
    "../src/renderer/src/**/*.tsx",
    "../app/Catalogo/GameMod/ui/**/*",
    "../app/Catalogo/GameMod/ui/**/*.tsx",
    "../app/ProtonTools/renderer/**/*",
    "../app/ProtonTools/renderer/**/*.tsx",
    "../src/big-picture/src/**/*",
    "../src/big-picture/src/**/*.tsx",
    "../src/preload/*.d.ts",
    "../src/locales/index.ts",
    "../src/shared/**/*",
  "../src/stories/**/*",
  "../src/types/**/*",
  "../app/Games/**/*",
    "../app/Home/**/*",
    "../app/Catalogue/**/*",
    "../app/Downloads/**/*",
    "../app/Settings/**/*",
    "../app/Profile/**/*",
    "../app/EmulatorDetail/**/*",
    "../app/Emulators/**/*",
    "../app/ExecutableSelect/**/*",
    "../app/FolderSelect/**/*",
    "../app/Library/**/*",
    "../app/Scripts/**/*",
    "../app/Notifications/**/*",
    "../app/SharedModals/**/*",
    "../app/ThemeEditor/**/*",
    "../app/_shared/components/**/*",
    "../app/_shared/hooks/**/*",
    "../app/_shared/context/**/*",
    "../app/_shared/services/**/*",
    "../app/_shared/utils/**/*",
    "../app/_shared/features/**/*",
    "../app/_shared/store.ts",
    "../src/renderer/src/theme/**/*",
  "../.storybook/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": "..",
    "noUnusedLocals": false,
    "paths": {
      "@renderer/*": [
        "src/renderer/src/*"
      ],
      "@types": ["src/types/index.ts"],
      "@mods/*": ["app/Catalogo/GameMod/*"],
      "@locales": ["src/locales/index.ts"],
      "@shared": ["src/shared/index.ts"],
      "@emulators/*": ["tools/emulators/*"],
      "@provision/*": ["data/install-api/*"],
      "@proton/*": ["app/ProtonTools/*"],
"@game-launcher/*": ["app/Games/services/game-launcher/*"],
      "@games-ui/*": ["app/Games/*"],
      "@home/*": ["app/Home/*"],
      "@catalogue/*": ["app/Catalogue/*"],
      "@downloads/*": ["app/Downloads/*"],
      "@settings/*": ["app/Settings/*"],
      "@profile/*": ["app/Profile/*"],
      "@emulator-detail/*": ["app/EmulatorDetail/*"],
      "@emulators/*": ["app/Emulators/*"],
      "@executable-select/*": ["app/ExecutableSelect/*"],
      "@folder-select/*": ["app/FolderSelect/*"],
      "@library/*": ["app/Library/*"],
      "@scripts/*": ["app/Scripts/*"],
      "@notifications/*": ["app/Notifications/*"],
      "@shared-modals/*": ["app/SharedModals/*"],
      "@theme-editor/*": ["app/ThemeEditor/*"],
      "@components/*": ["app/_shared/components/*"],
      "@hooks/*": ["app/_shared/hooks/*"],
      "@context/*": ["app/_shared/context/*"],
      "@shared-services/*": ["app/_shared/services/*"],
      "@shared-utils/*": ["app/_shared/utils/*"],
      "@features/*": ["app/_shared/features/*"],
      "@shared-store/*": ["app/_shared/*"],
      "@theme/*": ["src/renderer/src/theme/*"]
    }
  }
}
