{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "../src/renderer/src/env.d.ts",
    "../src/renderer/src/**/*",
    "../src/renderer/src/**/*.tsx",
    "../app/Catalogo/GameMod/ui/**/*",
    "../app/Catalogo/GameMod/ui/**/*.tsx",
    "../app/ProtonTools/renderer/**/*",
    "../app/ProtonTools/renderer/**/*.tsx",
    "../src/big-picture/src/**/*",
    "../src/big-picture/src/**/*.tsx",
    "../src/preload/*.d.ts",
    "../src/locales/index.ts",
    "../src/shared/**/*",
  "../src/stories/**/*",
  "../src/types/**/*",
  "../app/Games/**/*",
    "../app/Home/**/*",
    "../app/Catalogue/**/*",
  "../.storybook/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": "..",
    "noUnusedLocals": false,
    "paths": {
      "@renderer/*": [
        "src/renderer/src/*"
      ],
      "@types": ["src/types/index.ts"],
      "@mods/*": ["app/Catalogo/GameMod/*"],
      "@locales": ["src/locales/index.ts"],
      "@shared": ["src/shared/index.ts"],
      "@emulators/*": ["tools/emulators/*"],
      "@provision/*": ["data/install-api/*"],
      "@proton/*": ["app/ProtonTools/*"],
"@game-launcher/*": ["app/Games/services/game-launcher/*"],
      "@games-ui/*": ["app/Games/*"],
      "@home/*": ["app/Home/*"],
      "@catalogue/*": ["app/Catalogue/*"]
    }
  }
}
